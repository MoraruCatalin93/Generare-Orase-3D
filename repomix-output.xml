  background: var(--color-accent);
  color: var(--color-text-on-accent);
  font-weight: 600;
}

.project-actions {
  display: flex;
  gap: 4px;
  margin-top: 6px;
}
.project-actions button {
  flex: 1 1 auto;
}

.new-project-box {
