        mod = TerrainModifier(
            op="flatten",
            name=name or f"Flatten Terrain ({target_height_m:.1f}m)",
            center_x=float(center_xy[0]),
            center_y=float(center_xy[1]),
            radius_m=float(radius_m),
            target_height_m=float(target_height_m),
            strength=float(strength),
            falloff=falloff,
