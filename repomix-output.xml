@import "./theme.css";

:root {
  --bg: var(--color-bg);
  --panel: var(--color-surface);
  --panel-2: var(--color-surface-elevated);
  --line: var(--color-border);
  --text: var(--color-text);
  --dim: var(--color-text-secondary);
  --accent: var(--color-accent);
  --accent-2: var(--color-accent-hover);
  --warn: var(--color-warning);
  --radius: var(--radius-xl);
}
* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; overflow: hidden;
  background: var(--bg); color: var(--text);
  font: 13px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }

#map { position: fixed; inset: 0 348px 0 0; }
.maplibregl-ctrl-group { background: var(--panel) !important; border: 1px solid var(--line) !important; }
.maplibregl-ctrl-group button + button { border-top: 1px solid var(--line) !important; }
.maplibregl-ctrl-attrib { background: #0e1116bb !important; font-size: 10px; }
.maplibregl-ctrl-attrib a { color: var(--dim) !important; }

/* --------------------------------------------------------------- panou */
#panel { position: fixed; top: 0; right: 0; bottom: 0; width: 348px;
  background: var(--panel); border-left: 1px solid var(--line);
  overflow-y: auto; padding: 14px 16px 20px; backdrop-filter: blur(12px); }
#panel::-webkit-scrollbar { width: 8px; }
#panel::-webkit-scrollbar-thumb { background: #2b3542; border-radius: 4px; }

header { display: flex; align-items: baseline; justify-content: space-between;
  margin-bottom: 12px; }
.logo { font-size: 17px; font-weight: 700; letter-spacing: .3px; }
.logo span { color: var(--accent); font-weight: 500; }
.ver { color: var(--dim); font-size: 11px; }

section { padding: 12px 0; border-top: 1px solid var(--line); }
section:first-of-type { border-top: 0; padding-top: 0; }
.label { color: var(--dim); font-size: 10.5px; text-transform: uppercase;
  letter-spacing: .09em; margin-bottom: 8px; display: flex; justify-content: space-between; }
.label span { color: var(--accent); text-transform: none; letter-spacing: 0; }

label { display: block; color: var(--dim); font-size: 11px; }
input, select { width: 100%; margin-top: 3px; background: var(--panel-2); color: var(--text);
  border: 1px solid var(--line); border-radius: 8px; padding: 6px 8px; font-size: 12.5px;
  font-family: inherit; }
input:focus, select:focus { outline: none; border-color: var(--accent); }
input[type=number] { font-variant-numeric: tabular-nums; }

.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.grid2.tight { margin-top: 8px; }
.checks { display: flex; flex-direction: column; gap: 5px; margin-top: 10px; }
.checks label { display: flex; align-items: center; gap: 7px; color: var(--text);
  font-size: 12px; cursor: pointer; }
input[type=checkbox] { accent-color: var(--accent); width: auto; margin: 0; }

button, .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  border: 1px solid var(--line); background: var(--panel-2); color: var(--text);
  border-radius: 9px; padding: 8px 11px; font-size: 12.5px; font-family: inherit;
  cursor: pointer; text-decoration: none; transition: border-color .15s, color .15s, background .15s; }
button:hover, .btn:hover { border-color: var(--accent); color: var(--accent); }
.wide { width: 100%; }
.primary { border-color: #35506a; background: #1b2a3a; }
